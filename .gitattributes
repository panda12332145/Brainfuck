# Scripts do Windows precisam de CRLF de verdade, inclusive no repositório
# (-text = sem conversão, então o byte gravado é o byte do arquivo. Assim o
#  iniciar.bat funciona tanto clonando quanto baixando o ZIP do GitHub.)
*.bat  -text
*.cmd  -text
*.ps1  text eol=crlf

# Scripts de shell precisam de LF
*.sh       text eol=lf
*.command  text eol=lf

# O resto segue o padrão do repositório
*.ts    text eol=lf
*.tsx   text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf

# Binários não devem ser normalizados
*.png  binary
*.jpg  binary
*.ico  binary
*.woff binary
